# ---------------------------------------------------------------------------
# Makefile.gfortran — compilacao do RLINE v1.2 standalone (gfortran)
#
# Dependencias de modulos expressas para permitir `make -j$(nproc) -f Makefile.gfortran`:
#   Data_Structures.f90  -> module Data_Structures (sem dependencias)
#   Line_Source_Data.f90 -> module Line_Source_Data (usa Data_Structures)
#   demais arquivos      -> usam Line_Source_Data
# Os .mod sao gerados como efeito colateral da compilacao dos .o.
#
#   Binario gerado: RLINEv1_2_gfortran.x
#   Limpeza:        make -f Makefile.gfortran clean
# ---------------------------------------------------------------------------
.PHONY: all clean

EXE = RLINEv1_2_gfortran.x
FC = gfortran
FFLAGS = -O1 -Wall -fbounds-check

SRCS = \
 Data_Structures.f90 \
 Line_Source_Data.f90 \
 RLINE_Main.f90 \
 Read_Line_Source_Inputs.f90 \
 Read_Met_Inputs.f90 \
 Read_Receptors.f90 \
 Read_Sources.f90 \
 Compute_File_Size.f90 \
 Create_Exp_Table.f90 \
 Expx.f90 \
 Fill_Met.f90 \
 Compute_Met.f90 \
 Translate_Rotate.f90 \
 Numerical_Line_Source.f90 \
 Point_Conc.f90 \
 Meander.f90 \
 Polyinterp.f90 \
 Sigmay.f90 \
 Sigmaz.f90 \
 MOST_Wind.f90 \
 Effective_Wind.f90 \
 Analytical_Line_Source.f90 \
 Analytical_Line_Parallel.f90 \
 Barrier_Displacement.f90 \
 Depressed_Displacement.f90 \
 Write_Hourly_All.f90 \
 Write_Hourly_by_Month.f90 \
 Write_Daily_Ave.f90 \
 Deallocate_arrays.f90

OBJS = $(SRCS:.f90=.o)
DEP_LEAF = Data_Structures.o
DEP_LINE = Line_Source_Data.o
DEP_OTHER = $(filter-out $(DEP_LEAF) $(DEP_LINE),$(OBJS))

%.o: %.f90
	$(FC) $(FFLAGS) -c $<

# ---- Dependencias topologicas ---------------------------------------------
$(DEP_LINE): $(DEP_LEAF)
$(DEP_OTHER): $(DEP_LINE)

.DEFAULT_GOAL := all

all: $(EXE)

$(EXE): $(OBJS)
	$(FC) $(FFLAGS) -o $@ $(OBJS)

clean:
	rm -f *.o *.mod $(EXE)
