+      module RLINE_Validation
+
+      use Data_Structures, only: AVSurfaceMet, double
+      use ieee_arithmetic, only: ieee_is_finite
+      use iso_fortran_env, only: error_unit
+      implicit none
+      private
+
+      public :: Meteorology_Is_Valid, Require_Allocation, Require_IO
+
+      contains
+
+      subroutine Require_Allocation(status, operation)
+        integer, intent(in) :: status
+        character(len=*), intent(in) :: operation
+
+        if (status /= 0) then
+          write(error_unit,'(A,I0)') "RLINE allocation error during "//trim(operation)// &
+                                     "; status=",status
+          error stop 1
+        end if
+      end subroutine Require_Allocation
+
+      subroutine Require_IO(status, operation, io_message)
+        integer, intent(in) :: status
+        character(len=*), intent(in) :: operation, io_message
+
+        if (status /= 0) then
+          write(error_unit,'(A)') "RLINE I/O error while "//trim(operation)//": "// &
+                                  trim(io_message)
+          error stop 1
+        end if
+      end subroutine Require_IO
+
+      logical function Meteorology_Is_Valid(met, reason)
+        type(AVSurfaceMet), intent(in) :: met
+        character(len=*), intent(out) :: reason
+
+        Meteorology_Is_Valid=.false.
+        reason=""
+
+        if (met%Month < 1 .or. met%Month > 12 .or. &
+            met%Day < 1 .or. met%Day > 31 .or. &
+            met%J_Day < 1 .or. met%J_Day > 366 .or. &
+            met%Hour < 1 .or. met%Hour > 24) then
+          reason="invalid date/hour fields"
+          return
+        end if
+
+        if (.not. all(ieee_is_finite((/ met%Hs,met%Ustar,met%Wstar,met%CBL, &
+                                       met%SBL,met%Lmon,met%z0,met%Ws,met%Wd, &
+                                       met%zref /)))) then
+          reason="non-finite mandatory field"
+          return
+        end if
+
+        if (met%Hs == -999.0_double) then
+          reason="missing sensible heat flux"
+          return
+        end if
+        if (met%Ustar <= 0.0_double) then
+          reason="friction velocity must be positive"
+          return
+        end if
+        if (met%Hs > 0.0_double .and. met%Wstar < 0.0_double) then
+          reason="convective velocity must be nonnegative in unstable conditions"
+          return
+        end if
+        if (max(met%CBL,met%SBL) <= 0.0_double) then
+          reason="mixing height must be positive"
+          return
+        end if
+        if (abs(met%Lmon) <= tiny(met%Lmon)) then
+          reason="Monin-Obukhov length must be nonzero"
+          return
+        end if
+        if (met%z0 <= 0.0_double) then
+          reason="roughness length must be positive"
+          return
+        end if
+        if (met%Ws <= 0.0_double) then
+          reason="wind speed must be positive"
+          return
+        end if
+        if (met%Wd < 0.0_double .or. met%Wd > 360.0_double) then
+          reason="wind direction must be in [0, 360] degrees"
+          return
+        end if
+        if (met%zref <= 0.0_double) then
+          reason="wind reference height must be positive"
+          return
+        end if
+
+        Meteorology_Is_Valid=.true.
+      end function Meteorology_Is_Valid
+
+      end module RLINE_Validation
